# Keep secrets and local build junk out of the image. Without this the
# Dockerfile's `COPY . .` bakes .env straight into a layer, where anyone with
# the image can read it back out.
.env
.env.*
*.pem

node_modules
.next
out
build
coverage

.git
.gitignore
.dockerignore
Dockerfile
docker-compose*.yml

.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.vscode
.idea
.cursor
.agents
skills-lock.json

*.tsbuildinfo
outdated.txt
README.md
