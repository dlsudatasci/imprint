# systemd unit for Imprint.
#
# Install on the VM as /etc/systemd/system/imprint.service, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now imprint
#   sudo systemctl status imprint
#   journalctl -u imprint -f          # logs
#
# Assumes the standalone build lives at /srv/imprint and .env sits beside it.
# Adjust User= and the paths if you deploy somewhere else.

[Unit]
Description=Imprint (Next.js)
Documentation=https://github.com/dlsudatasci/imprint
After=network-online.target
Wants=network-online.target
# MongoDB runs on the same VM (staging and production, Step 4), so the app
# starts after it. On a VM without a local mongod these two lines do nothing.
After=mongod.service
Wants=mongod.service
# Restart forever rather than giving up after the default 5 tries in 10s:
# a VM that reboots with Mongo still starting shouldn't leave the app dead.
# This belongs in [Unit]. Under [Service] systemd ignores it with a warning.
StartLimitIntervalSec=0

[Service]
Type=simple
User=imprint
Group=imprint
WorkingDirectory=/srv/imprint

# EnvironmentFile is read by systemd, not by a shell: no quotes, no export,
# no variable expansion. Keep it 0600 and owned by the service user.
EnvironmentFile=/srv/imprint/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_TELEMETRY_DISABLED=1

ExecStart=/usr/bin/node server.js

Restart=on-failure
RestartSec=5s
# Node exits with 143 (128 + SIGTERM) when systemctl stops it. Counting that
# as success means a deliberate stop shows "inactive", not "failed", so a
# real crash stands out, and Restart=on-failure does not restart a stop.
SuccessExitStatus=143

StandardOutput=journal
StandardError=journal
SyslogIdentifier=imprint

# --- hardening -------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/imprint
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
